# Public URL of the deployed site (used for canonical URL, Open Graph, sitemap, robots).
# Set it in Cloudflare Pages -> Settings -> Environment variables.
NUXT_PUBLIC_SITE_URL=https://gloria-galasso.pages.dev

# Optional: GitHub token used at build time to fetch the repos (avoids rate limits on shared CI IPs).
# No scopes needed, it only reads public data. If missing/failing, a bundled snapshot is used.
NUXT_GITHUB_TOKEN=
